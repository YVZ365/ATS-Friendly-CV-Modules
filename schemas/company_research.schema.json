{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Company Research Output",
  "type": "object",
  "required": ["company_name", "industry", "recent_signals", "candidate_angles"],
  "properties": {
    "company_name": {"type": "string"},
    "industry": {"type": "string"},
    "recent_signals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "candidate_angles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
