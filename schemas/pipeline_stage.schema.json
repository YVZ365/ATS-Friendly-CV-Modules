{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline Stage Detection Result",
  "type": "object",
  "required": ["stage", "years_experience", "confidence", "signals"],
  "properties": {
    "stage": {
      "type": "string",
      "enum": ["junior", "mid", "senior", "lead"]
    },
    "years_experience": {
      "type": "number",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signals": {
      "type": "object",
      "properties": {
        "title_keywords": {
          "type": "array",
          "items": {"type": "string"}
        },
        "experience_stage": {"type": "string"}
      }
    }
  }
}
